{
  "name": "own-api",
  "version": "0.1.15",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "本地多模型管理器 + 统一代理网关（号池）",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "mock": "tsx src/mock-upstream.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "test": "tsx test/e2e.ts",
    "test:hard": "tsx test/hardening.ts",
    "test:all": "tsx test/e2e.ts && tsx test/hardening.ts",
    "typecheck": "tsc --noEmit",
    "gen:web": "node scripts/gen-web-html.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "desktop:prepare": "npm run gen:web && node scripts/build-sea.mjs && node scripts/prepare-desktop.mjs",
    "desktop:build": "npm run desktop:prepare && tauri build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.16",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.12"
  }
}
