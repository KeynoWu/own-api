{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "own-api",
  "version": "0.1.2",
  "identifier": "dev.ownapi.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:8787",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../web-static"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "externalBin": ["binaries/own-api"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "macOS": { "minimumSystemVersion": "10.15" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false }
    }
  }
}
